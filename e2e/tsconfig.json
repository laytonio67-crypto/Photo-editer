    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": [
    ".",
    "../src/engine/adjustments/math.ts",
    "../src/engine/adjustments/curves.ts",
    "../src/engine/adjustments/types.ts",
    "../src/engine/color/color.ts",
    "../src/engine/doc/types.ts",
    "../src/engine/geometry.ts"
  ]
}
